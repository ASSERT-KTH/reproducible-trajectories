#!/usr/bin/env python3
"""
pre-commit hook: verifies that staged trajectory files are reproducible.

For each trajectory file staged under trajectories/, simulates its Write/Edit
operations against the HEAD state of each modified file and checks that the
result matches the staged (index) version.  Mirrors the logic of the
verify-trajectories subcommand.

Status values (per file):
  match         — simulated content matches staged content
  mismatch      — simulated content differs from staged content
  unverifiable  — file modified only by NotebookEdit, or path cannot be resolved
  outside_repo  — file lies outside the repository

The commit is rejected if any file has status 'mismatch'.

Install as a git hook:
  ln -s ../../hooks/pre-commit-verify-trajectory .git/hooks/pre-commit
"""

import io
import json
import subprocess
import sys
from pathlib import Path

try:
    from reproducible_trajectories.trajectory import build_sequence, get_session_info, _simulate_ops, _rel
except ImportError:
    _HOOKS_DIR = Path(__file__).resolve().parent
    sys.path.insert(0, str(_HOOKS_DIR.parent))
    from reproducible_trajectories.trajectory import build_sequence, get_session_info, _simulate_ops, _rel


# ---------------------------------------------------------------------------
# Git helpers
# ---------------------------------------------------------------------------

def _git(args):
    r = subprocess.run(["git"] + args, capture_output=True)
    return r.returncode, r.stdout.decode("utf-8", errors="replace")


def _repo_root():
    rc, out = _git(["rev-parse", "--show-toplevel"])
    return Path(out.strip()) if rc == 0 else Path.cwd()


def _staged_trajectory_paths():
    """Return repo-relative paths for staged trajectory JSONL files."""
    rc, out = _git(["diff", "--cached", "--name-only", "--diff-filter=ACM"])
    if rc != 0:
        return []
    return [
        p for p in out.splitlines()
        if p.startswith("trajectories/") and p.endswith(".jsonl")
    ]


def _read_index(rel_path):
    """Return content of rel_path from the index, or None."""
    rc, out = _git(["show", f":{rel_path}"])
    return out if rc == 0 else None


def _read_head(rel_path):
    """Return content of rel_path at HEAD, or None."""
    rc, out = _git(["show", f"HEAD:{rel_path}"])
    return out if rc == 0 else None


# ---------------------------------------------------------------------------
# Trajectory verification
# ---------------------------------------------------------------------------

def _parse_events(content):
    events = []
    for line in io.StringIO(content):
        line = line.strip()
        if line:
            events.append(json.loads(line))
    return events


def verify_staged_trajectory(traj_rel_path, repo_root):
    """
    Simulate the trajectory's Write/Edit ops on HEAD and compare with the index.

    Returns (status, file_results) where status is one of:
      'reproducible', 'not_reproducible', 'no_operations', 'trajectory_not_found'
    """
    content = _read_index(traj_rel_path)
    if content is None:
        return "trajectory_not_found", []

    events = _parse_events(content)
    sequence, _tool_uses = build_sequence(events)
    _, session_cwd = get_session_info(events)

    # Collect Write/Edit/NotebookEdit ops in order
    ops = []
    for s in sequence:
        if s["seq_type"] != "tool_use":
            continue
        item = s["item"]
        name = item.get("name")
        if name in ("Write", "Edit", "NotebookEdit"):
            ops.append({"tool": name, "input": item.get("input", {})})

    if not any(op["tool"] in ("Write", "Edit") for op in ops):
        return "no_operations", []

    # Determine which files are touched only by NotebookEdit (unverifiable)
    notebook_only = set()
    write_edit_files = set()
    for op in ops:
        tool = op["tool"]
        inp = op["input"]
        fp = inp.get("notebook_path" if tool == "NotebookEdit" else "file_path", "")
        if not fp:
            continue
        if tool == "NotebookEdit":
            if fp not in write_edit_files:
                notebook_only.add(fp)
        else:
            write_edit_files.add(fp)
            notebook_only.discard(fp)

    # Build initial states from HEAD
    initial_states = {}
    file_rels = {}
    for op in ops:
        tool = op["tool"]
        inp = op["input"]
        fp = inp.get("notebook_path" if tool == "NotebookEdit" else "file_path", "")
        if not fp or fp in initial_states:
            continue
        rel = _rel(fp, session_cwd) if session_cwd else None
        file_rels[fp] = rel
        initial_states[fp] = _read_head(rel) if rel else None

    simulated = _simulate_ops(ops, initial_states)

    file_results = []
    any_mismatch = False

    for fp, sim_content in simulated.items():
        if fp in notebook_only:
            file_results.append({"file": fp, "status": "unverifiable"})
            continue

        rel = file_rels.get(fp)

        if session_cwd is not None and rel is None:
            file_results.append({"file": fp, "status": "outside_repo"})
            continue

        if rel is None:
            file_results.append({"file": fp, "status": "unverifiable"})
            continue

        try:
            Path(fp).resolve().relative_to(repo_root)
        except ValueError:
            file_results.append({"file": rel, "status": "outside_repo"})
            continue

        actual = _read_index(rel)
        if sim_content == actual:
            file_results.append({"file": rel, "status": "match"})
        else:
            file_results.append({"file": rel, "status": "mismatch"})
            any_mismatch = True

    status = "not_reproducible" if any_mismatch else "reproducible"
    return status, file_results


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main():
    staged = _staged_trajectory_paths()
    if not staged:
        sys.exit(0)

    repo_root = _repo_root()
    all_ok = True

    for traj_path in staged:
        status, file_results = verify_staged_trajectory(traj_path, repo_root)
        if status == "not_reproducible":
            print(f"pre-commit: trajectory not reproducible: {traj_path}", file=sys.stderr)
            for fr in file_results:
                if fr["status"] == "mismatch":
                    print(f"  mismatch: {fr['file']}", file=sys.stderr)
            all_ok = False
        elif status == "trajectory_not_found":
            print(f"pre-commit: trajectory not found in index: {traj_path}", file=sys.stderr)
            all_ok = False

    sys.exit(0 if all_ok else 1)


if __name__ == "__main__":
    main()
